# Resend (https://resend.com) — powers the contact form.
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your domain at https://resend.com/domains so you can send from it
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered (comma-separate multiple addresses)
CONTACT_TO_EMAIL=info@sakarwindowsystem.com

# Sender shown on emails — must be on your verified Resend domain
CONTACT_FROM_EMAIL="Sakar Window System <noreply@sakarwindowsystem.com>"
